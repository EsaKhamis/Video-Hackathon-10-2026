# Optional overrides. On the team VM, W&B, VSS backend and GPU credentials are already exported
# (WANDB_API_KEY, WANDB_PROJECT, WANDB_TEAM, INGRESS_URL, USERNAME, PASSWORD, GPU_BEARER_TOKEN),
# so the only thing you must set is COSMOS_BASE_URL. Copy to .env (git-ignored).

# --- CoreWeave Forge / W&B Serverless Inference (agent LLM) ---
# LLM_BASE_URL=https://api.inference.wandb.ai/v1
# LLM_MODEL=openai/gpt-oss-120b

# --- Cosmos Reason (OpenAI-compatible NIM on the team GPU host, port 8001) ---
# Host is in the gpu-model-health skill. Auth defaults to GPU_BEARER_TOKEN.
COSMOS_BASE_URL=http://<gpu-host>:8001/v1
# COSMOS_MODEL=nvidia/cosmos3-nano-reasoner
# COSMOS_MAX_FRAMES=5   # the hosted NIM rejects more than 5 images per prompt

# --- VSS retrieval backend (search) ---
# Defaults to INGRESS_URL / USERNAME / PASSWORD. Set VAST_BASE_URL= to an empty value
# AND unset INGRESS_URL to fall back to the local JSON index in data/index.json.
# VAST_BASE_URL=

# --- Real-time lane (needs: uv sync --extra realtime) ---
VIDEO_SOURCE=data/footage/sample.mp4
YOLO_MODEL=yolo11n.pt
STREAM_FPS=3
CLIP_SECONDS=6
# What flags a clip for Cosmos: "yolo" (TRIGGER_CLASSES below) or "scoreboard".
TRIGGER_MODE=yolo
SCOREBOARD_ROI=150,8,258,72
# Comma-separated YOLO class names that trigger Cosmos.
TRIGGER_CLASSES=car,truck,bus
TRIGGER_MIN_FRAMES=3
TRIGGER_COOLDOWN_S=10
