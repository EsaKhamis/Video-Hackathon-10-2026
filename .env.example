# Copy to .env and fill in on build day.

# --- CoreWeave Forge / W&B Serverless Inference (agent LLM) ---
# Key: https://forge.coreweave.com/settings
WANDB_API_KEY=
WANDB_PROJECT=your-team/video-agent
LLM_BASE_URL=https://api.inference.wandb.ai/v1
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# --- Cosmos Reason 2 (OpenAI-compatible endpoint, e.g. vLLM on CoreWeave) ---
COSMOS_BASE_URL=
COSMOS_API_KEY=
COSMOS_MODEL=nvidia/Cosmos-Reason2-2B
COSMOS_MAX_FRAMES=8

# --- VAST build environment (search + ingest) ---
# Leave VAST_BASE_URL empty to use the local JSON index in data/index.json.
VAST_BASE_URL=
VAST_API_KEY=

# --- Real-time lane ---
VIDEO_SOURCE=data/footage/sample.mp4
YOLO_MODEL=yolo11n.pt
STREAM_FPS=3
CLIP_SECONDS=6
# What flags a clip for Cosmos: "yolo" (TRIGGER_CLASSES below) or "scoreboard".
TRIGGER_MODE=yolo
# Scoreboard mode: x1,y1,x2,y2 of the score digits in source pixels (default fits 1280x720 BWF broadcast).
SCOREBOARD_ROI=150,8,258,72
# Comma-separated YOLO class names that trigger Cosmos.
TRIGGER_CLASSES=person
# Frames a trigger class must persist before a clip is flagged.
TRIGGER_MIN_FRAMES=3
# Seconds to wait before flagging the same track again.
TRIGGER_COOLDOWN_S=10
